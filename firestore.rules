rules_version = '2';

// Skyline Cycle Terminal — Firestore Security Rules
//
// Architecture: Firestore serves two purposes:
//   1. A read-through cache for public market data (prices, on-chain metrics, macro data).
//      Vercel API routes write to the cache once per day using the client SDK; the browser
//      reads from it to avoid hitting external API rate limits. No PII, no user data.
//   2. Subscriber entitlement records (users/{uid}) — server-only, see below.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Cache collection ─────────────────────────────────────────────────────
    // Stores daily snapshots of external API responses.
    // Documents: price_btc, price_eth, metrics_btc, feargreed, macro, cycle_score
    match /cache/{document=**} {
      allow read: if true;   // Browser reads cached market data
      allow write: if true;  // Vercel API routes (client SDK) write daily snapshots
    }

    // ── Observation store ────────────────────────────────────────────────────
    // Append-only point-in-time history of what the terminal read on each day —
    // see lib/store/observations.ts. Written only by app/api/cron/* via
    // firebase-admin (which bypasses rules). Closed to the client SDK in both
    // directions on purpose: this is the record a track record would be argued
    // from, and a publicly writable history is not evidence.
    match /observations/{observationId} {
      allow read, write: if false;
    }

    // ── Observation store registry ───────────────────────────────────────────
    // One document listing every metric id the store has written. Exists because
    // Firestore has no DISTINCT and the evidence-ledger ids are generated per
    // run, so the admin panel would otherwise have to read the whole collection
    // to know what is in it. Written by the same cron routes, via firebase-admin.
    match /observations_meta/{docId} {
      allow read, write: if false;
    }

    // ── Subscriber entitlement records ───────────────────────────────────────
    // Written only by server-side code (firebase-admin, which bypasses rules
    // entirely) — via webhooks and the auth session route. The client SDK never
    // reads or writes this collection directly; entitlement is only ever
    // obtained server-side through the app's requireAccess() DAL.
    match /users/{uid} {
      allow read, write: if false;
    }

    // ── Waitlist signups ──────────────────────────────────────────────────────
    // Written only by app/api/waitlist/route.ts via firebase-admin (bypasses
    // rules). Never read/written by the client SDK directly.
    match /waitlist/{email} {
      allow read, write: if false;
    }

    // ── Skyline Weekly subscribers ────────────────────────────────────────────
    // Written only by app/api/subscribe/route.ts via firebase-admin (bypasses
    // rules). Holds email addresses, so it must never be client-readable.
    match /subscribers/{email} {
      allow read, write: if false;
    }

    // ── Newsletter send records ───────────────────────────────────────────────
    // One document per issue, written only by app/api/newsletter/send/route.ts
    // via firebase-admin. Its existence is what stops the same issue going out
    // twice, so it must never be client-writable.
    match /campaigns/{campaignId} {
      allow read, write: if false;
    }

    // ── Stripe customer → uid reverse lookup ─────────────────────────────────
    // Written only by app/api/stripe/webhook/route.ts via firebase-admin. Needed
    // because subscription update/delete events only carry the Stripe customer
    // ID, not the Firebase uid.
    match /stripeCustomers/{stripeCustomerId} {
      allow read, write: if false;
    }

    // ── Contact form submissions ──────────────────────────────────────────────
    // Written only by app/api/contact/route.ts via firebase-admin. Never
    // read/written by the client SDK directly.
    match /contactMessages/{messageId} {
      allow read, write: if false;
    }

    // ── Block all other paths ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
